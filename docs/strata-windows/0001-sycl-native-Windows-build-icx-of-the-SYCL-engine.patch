--- /dev/null
+++ b/sycl/include/strata_win_undefs.h
@@ -0,0 +1,8 @@
+// Windows port: names <windows.h> defines as macros that the engine uses as identifiers
+// (rpcndr.h: small; minwindef.h: IN, OUT). Include right after <windows.h>.
+// no include guard on purpose: each include re-runs the #undefs
+#ifdef _WIN32
+#undef small
+#undef OUT
+#undef IN
+#endif
