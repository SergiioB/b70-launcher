+// no memmem in the Windows CRT (used only by a load-check diagnostic)
+static const void* memmem(const void* hay, size_t hn, const void* needle, size_t nn) {
+    if (nn == 0) return hay;
+    const unsigned char* h = (const unsigned char*) hay;
+    for (size_t i = 0; i + nn <= hn; ++i)
