 namespace strata::core {
@@ -32,6 +33,25 @@ inline bool ep_region_alloc(int owner, int other, size_t bytes, EpRegion& r, std
     r = EpRegion{};
     r.owner_ctx = ep_ze_context(owner);
     r.other_ctx = ep_ze_context(other);
+#if defined(_WIN32)
+    // Windows: no IPC and no peer access between the cards, so the region is host memory in the context both cards
+    // share (dpct strata_device_context): one address for both, every access over PCIe (system-scope atomics).
+    if (r.owner_ctx == r.other_ctx) {
+        ze_host_mem_alloc_desc_t hdesc{};
+        hdesc.stype = ZE_STRUCTURE_TYPE_HOST_MEM_ALLOC_DESC;
+        ze_result_t zh = zeMemAllocHost(r.owner_ctx, &hdesc, bytes, 4096, &r.local);
+        if (zh != ZE_RESULT_SUCCESS) {
+            err = "expert parallel: zeMemAllocHost of " + std::to_string(bytes) + " bytes failed (" + std::to_string((unsigned) zh) + ")";
+            r.local = nullptr;
+            return false;
+        }
+        std::memset(r.local, 0, bytes);
+        r.remote = r.local;
+        return true;
+    }
+    err = "expert parallel: the cards have separate contexts (STRATA_WIN_SHARED_CONTEXT=0?) and Windows has no IPC";
+    return false;
+#endif
     ze_device_mem_alloc_desc_t desc{};
     desc.stype = ZE_STRUCTURE_TYPE_DEVICE_MEM_ALLOC_DESC;
     ze_result_t z = zeMemAllocDevice(r.owner_ctx, &desc, bytes, 4096, ep_ze_device(owner), &r.local);
@@ -54,7 +74,7 @@ inline bool ep_region_alloc(int owner, int other, size_t bytes, EpRegion& r, std
