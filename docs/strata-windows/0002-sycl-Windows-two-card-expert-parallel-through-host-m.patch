-    if (r.remote != nullptr) zeMemCloseIpcHandle(r.other_ctx, r.remote);
+    if (r.remote != nullptr && r.remote != r.local) zeMemCloseIpcHandle(r.other_ctx, r.remote);
     if (r.local != nullptr) zeMemFree(r.owner_ctx, r.local);
     r = EpRegion{};
 }
