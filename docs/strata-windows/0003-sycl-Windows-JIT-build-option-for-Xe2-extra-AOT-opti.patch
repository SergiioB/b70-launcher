diff --git a/sycl/CMakeLists.txt b/sycl/CMakeLists.txt
index 5d4ece6..56becbb 100644
--- a/sycl/CMakeLists.txt
+++ b/sycl/CMakeLists.txt
@@ -37,7 +37,9 @@ if(STRATA_SYCL_SPIN_MAX)
   add_compile_definitions(STRATA_SYCL_SPIN_MAX=${STRATA_SYCL_SPIN_MAX}u)
 endif()
 set(_sycl_flags -fsycl)
-if(STRATA_SYCL_AOT MATCHES "^(bmg|lnl)")
+# JIT on an Xe2 card (B-series): the AOT build defines this from the device name; a JIT build asks for it here
+option(STRATA_SYCL_XE2_JIT "JIT build for an Xe2 (Arc B-series / Lunar Lake) card: the sub-group-16 XMX kernels" OFF)
+if(STRATA_SYCL_AOT MATCHES "^(bmg|lnl)" OR (NOT STRATA_SYCL_AOT AND STRATA_SYCL_XE2_JIT))
   add_compile_definitions(STRATA_XMX_SG16=1)   # the grouped XMX kernels on sub-group 16, joint_matrix 8x16x16 (Xe2)
 elseif(STRATA_SYCL_AOT MATCHES "^pvc")
   add_compile_definitions(STRATA_NO_DG2_XMX=1)   # the grouped XMX kernels (sub-group 8, 8x8x16) do not compile for Xe2 / Xe-HPC
@@ -50,8 +52,14 @@ if(STRATA_SYCL_AOT)
   if(STRATA_SYCL_AOT_CACHE_DIR)
     set(_sycl_cache_flags " -allow_caching -cache_dir ${STRATA_SYCL_AOT_CACHE_DIR}")
   endif()
+  # extra ocloc -options for the AOT device code (e.g. -ze-opt-greater-than-4GB-buffer-required)
+  set(STRATA_SYCL_AOT_OPTIONS "" CACHE STRING "extra ocloc -options for the AOT build")
+  set(_sycl_aot_opts "-cl-fp32-correctly-rounded-divide-sqrt")
+  if(STRATA_SYCL_AOT_OPTIONS)
+    string(APPEND _sycl_aot_opts " ${STRATA_SYCL_AOT_OPTIONS}")
+  endif()
   set(_sycl_link -fsycl -fsycl-targets=spir64_gen -Xsycl-target-backend=spir64_gen
-      "-device ${STRATA_SYCL_AOT} -options -cl-fp32-correctly-rounded-divide-sqrt${_sycl_cache_flags}")
+      "-device ${STRATA_SYCL_AOT} -options \"${_sycl_aot_opts}\"${_sycl_cache_flags}")
 else()
   set(_sycl_link -fsycl)
 endif()
